{
  "placeholder": "(.)\\1{9}",
  "patterns": [
    {
      "name": "private-key",
      "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----(?=(?:(?!-----)[\\s\\S])*?(?:[A-Za-z0-9+/]\\r?\\n?){40})(?:(?!-----)[\\s\\S])*-----END (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----"
    },
    {
      "name": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
    },
    {
      "name": "aws-access-key-id",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "placeholder": true
    },
    {
      "name": "aws-secret-access-key",
      "pattern": "(aws_secret_access_key[\"']?\\s*[:=]\\s*[\"']?)([A-Za-z0-9/+=]{40})(?![A-Za-z0-9/+=])()",
      "flags": "i",
      "partial": true,
      "placeholder": true
    },
    {
      "name": "github-token",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}",
      "placeholder": true
    },
    {
      "name": "github-pat",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{60,}",
      "placeholder": true
    },
    {
      "name": "gitlab-token",
      "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}",
      "placeholder": true
    },
    {
      "name": "slack-token",
      "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}",
      "placeholder": true
    },
    {
      "name": "slack-webhook",
      "pattern": "https://hooks\\.slack\\.com/services/T[A-Za-z0-9]+/B[A-Za-z0-9]+/[A-Za-z0-9]{20,}",
      "placeholder": true
    },
    {
      "name": "anthropic-key",
      "pattern": "\\bsk-ant-[A-Za-z0-9_-]{24,}",
      "placeholder": true
    },
    {
      "name": "openai-key",
      "pattern": "\\bsk-(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{32,}|[A-Za-z0-9]{32,})",
      "placeholder": true
    },
    {
      "name": "google-api-key",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])",
      "placeholder": true
    },
    {
      "name": "stripe-key",
      "pattern": "\\b(?:sk|rk)_(?:live|test)_[0-9A-Za-z]{24,}",
      "placeholder": true
    },
    {
      "name": "azure-storage-key",
      "pattern": "(\\bAccountKey=)([A-Za-z0-9+/]{40,}={0,2})()",
      "partial": true,
      "placeholder": true
    },
    {
      "name": "azure-sas-signature",
      "pattern": "([?&;]sig=)([A-Za-z0-9%+/_-]{30,}={0,2})()",
      "partial": true,
      "placeholder": true
    },
    {
      "name": "bearer-token",
      "pattern": "(\\bAuthorization\\s*:\\s*Bearer\\s+)((?=[A-Za-z0-9._~+/=-]*[0-9])[A-Za-z0-9._~+/=-]{16,})()",
      "flags": "i",
      "partial": true,
      "placeholder": true
    },
    {
      "name": "url-password",
      "pattern": "(\\b[A-Za-z][A-Za-z0-9+.-]{0,19}://[^\\s:/?#@'\"<>]+:)((?![$<{\\[*])(?!%(?:\\(|[A-Za-z_][A-Za-z0-9_]*%@))(?!(?:password|passwd|pass|pwd|secret|changeme|example|redacted|x{3,}|\\.+)@)[^\\s/?#@'\"<>]+)(@)",
      "flags": "i",
      "partial": true,
      "placeholder": true
    }
  ]
}

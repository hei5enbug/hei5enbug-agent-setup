{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  "agents": {
    "sisyphus": {
      "models": [
        { "model": "anthropic/claude-opus-5", "reasoning": "max" },
        { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
      ]
    },

    "hephaestus": {
      "models": [
        { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
      ]
    },

    "oracle": {
      "models": [
        { "model": "openai/gpt-5.6-sol", "reasoning": "xhigh" },
        { "model": "anthropic/claude-opus-5", "reasoning": "max" }
      ]
    },

    "librarian": {
      "models": [
        { "model": "openai/gpt-5.6-luna", "reasoning": "low" },
        "anthropic/claude-haiku-4-5"
      ]
    },

    "explore": {
      "models": [
        { "model": "openai/gpt-5.6-luna", "reasoning": "low" },
        "anthropic/claude-haiku-4-5"
      ]
    },

    "multimodal-looker": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "low"
    },

    "prometheus": {
      "models": [
        { "model": "anthropic/claude-fable-5-1", "reasoning": "xhigh" },
        "openai/gpt-5.6-sol"
      ]
    },

    "metis": {
      "models": [
        { "model": "anthropic/claude-opus-5", "reasoning": "high" },
        "openai/gpt-5.6-sol"
      ]
    },

    "momus": {
      "models": [
        { "model": "openai/gpt-5.6-terra", "reasoning": "high" },
        { "model": "openai/gpt-5.6-sol", "reasoning": "xhigh" },
        { "model": "anthropic/claude-opus-5", "reasoning": "max" }
      ]
    },

    "atlas": {
      "models": [
        "anthropic/claude-sonnet-5",
        { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
      ]
    },

    "sisyphus-junior": {
      "models": [
        "anthropic/claude-sonnet-5",
        { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
      ]
    }
  },

  "categories": {
    "visual-engineering": {
      "models": [
        { "model": "anthropic/claude-opus-5", "reasoning": "max" },
        { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
      ]
    },

    "ultrabrain": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "max"
    },

    "deep": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },

    "artistry": {
      "models": [
        { "model": "anthropic/claude-fable-5-1", "reasoning": "xhigh" },
        { "model": "anthropic/claude-opus-5", "reasoning": "xhigh" },
        "openai/gpt-5.6-sol"
      ]
    },

    "quick": {
      "models": [
        { "model": "openai/gpt-5.6-luna", "reasoning": "low" },
        { "model": "anthropic/claude-haiku-4-5", "reasoning": "off" }
      ]
    },

    "unspecified-low": {
      "models": [
        { "model": "openai/gpt-5.6-terra", "reasoning": "high" },
        { "model": "anthropic/claude-sonnet-5", "reasoning": "low" }
      ]
    },

    "unspecified-high": {
      "models": [
        { "model": "anthropic/claude-opus-5", "reasoning": "xhigh" },
        "openai/gpt-5.6-sol"
      ]
    },

    "writing": {
      "models": [
        { "model": "anthropic/claude-opus-5", "reasoning": "low" },
        "openai/gpt-5.6-sol"
      ]
    }
  },

  "[opencode]": {
    "disabled_hooks": ["no-sisyphus-gpt"],
    "runtime_fallback": true
  }
}

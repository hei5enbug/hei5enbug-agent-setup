{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/c18ab758961b88bc07f7578ddcbcb286810a524f/assets/omo.schema.json",
  "agents": {
    "oracle": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "fallback_models": ["anthropic/claude-opus-5"],
      "prompt": "Keep this field"
    }
  },
  "categories": {
    "deep": {
      "model": "anthropic/claude-haiku-4-5",
      "reasoning": "low"
    }
  },
  "[opencode]": {
    "agents": {
      "explore": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "fallback_models": ["anthropic/claude-haiku-4-5"]
      }
    }
  }
}

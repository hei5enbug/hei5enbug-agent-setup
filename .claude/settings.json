{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.githooks/agent_hook.sh\"; [ ! -f \"$f\" ] || exec sh \"$f\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

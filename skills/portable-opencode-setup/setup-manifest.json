{
  "description": "Additive installation manifest for portable-opencode-setup. Source of truth for missing plugins, MCPs, AAI apps, and custom skills to add without overwriting existing settings.",
  "plugins": [
    { "name": "opencode-claude-auth", "purpose": "Claude model authentication" },
    { "name": "opencode-antigravity-auth", "purpose": "Antigravity/Google gateway authentication" },
    { "name": "@datadog/opencode-plugin", "purpose": "Datadog integration" },
    { "name": "oh-my-openagent", "purpose": "Core orchestration plugin" }
  ],
  "mcps": {
    "always_on": [
      {
        "name": "context7",
        "role": "Documentation retrieval (Context7)",
        "opencode": {
          "type": "local",
          "command": ["npx", "-y", "@upstash/context7-mcp"],
          "enabled": true
        }
      },
      {
        "name": "grep_app",
        "role": "Code search across repositories",
        "opencode": {
          "type": "local",
          "command": ["npx", "-y", "@kenkaiiii/kencode-search"],
          "enabled": true
        }
      },
      {
        "name": "aai-gateway",
        "role": "AAI tool gateway",
        "opencode": {
          "type": "local",
          "command": ["npx", "-y", "aai-gateway"],
          "enabled": true
        }
      }
    ]
  },
  "aai_apps": {
    "preset": [
      { "name": "opencode", "type": "Preset" },
      { "name": "codex", "type": "Preset" },
      { "name": "claude", "type": "Preset" }
    ],
    "on_demand": [
      { "name": "github-mcp", "type": "On-demand" },
      { "name": "azure-devops-mcp", "type": "On-demand" },
      { "name": "atlassian-rovo", "type": "On-demand" },
      { "name": "postman-mcp", "type": "On-demand" }
    ]
  }
}

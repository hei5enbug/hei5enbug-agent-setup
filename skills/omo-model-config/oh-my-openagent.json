{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-openagent.schema.json",
  "google_auth": false,

  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-4-8",
      "variant": "max",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "medium" }
      ]
    },

    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": []
    },

    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        { "model": "anthropic/claude-opus-4-8", "variant": "max" }
      ]
    },

    "librarian": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        "anthropic/claude-haiku-4-5",
        "openai/gpt-5.4-nano"
      ]
    },

    "explore": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        "anthropic/claude-haiku-4-5",
        "openai/gpt-5.4-nano"
      ]
    },

    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.4-nano"
      ]
    },

    "prometheus": {
      "model": "anthropic/claude-opus-4-8",
      "variant": "max",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "high" }
      ]
    },

    "metis": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "high" }
      ]
    },

    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        { "model": "anthropic/claude-opus-4-8", "variant": "max" }
      ]
    },

    "atlas": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "medium" }
      ]
    },

    "sisyphus-junior": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "medium" }
      ]
    }
  },

  "categories": {
    "visual-engineering": {
      "model": "anthropic/claude-opus-4-8",
      "variant": "max",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "high" }
      ]
    },

    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        { "model": "anthropic/claude-opus-4-8", "variant": "max" }
      ]
    },

    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        { "model": "anthropic/claude-opus-4-8", "variant": "max" }
      ]
    },

    "artistry": {
      "model": "anthropic/claude-opus-4-8",
      "variant": "max",
      "fallback_models": [
        "openai/gpt-5.5"
      ]
    },

    "quick": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        "anthropic/claude-haiku-4-5"
      ]
    },

    "unspecified-low": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "medium" }
      ]
    },

    "unspecified-high": {
      "model": "anthropic/claude-opus-4-8",
      "variant": "max",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "high" }
      ]
    },

    "writing": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_models": [
        "openai/gpt-5.4-mini-fast"
      ]
    }
  },

  "disabled_hooks": ["no-sisyphus-gpt"],
  "runtime_fallback": true
}

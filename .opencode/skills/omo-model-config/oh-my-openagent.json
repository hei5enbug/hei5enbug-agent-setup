{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-openagent.schema.json",
  "google_auth": false,

  "agents": {
    "sisyphus": {
      "model": "opencode-go/kimi-k2.5",
      "fallback_models": ["openai/gpt-5.4"]
    },

    "hephaestus": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "fallback_models": []
    },

    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "fallback_models": ["google/antigravity-gemini-3.1-pro"]
    },

    "librarian": {
      "model": "opencode-go/minimax-m2.7",
      "fallback_models": ["opencode/minimax-m2.5-free", "opencode/gpt-5-nano", "openai/gpt-5.4-mini"]
    },

    "explore": {
      "model": "opencode-go/minimax-m2.7",
      "fallback_models": ["opencode/minimax-m2.5-free", "opencode/gpt-5-nano", "openai/gpt-5.4-mini"]
    },

    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "fallback_models": ["opencode-go/kimi-k2.5", "opencode/gpt-5-nano"]
    },

    "prometheus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "fallback_models": ["google/antigravity-gemini-3.1-pro"]
    },

    "metis": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "fallback_models": ["opencode-go/kimi-k2.5"]
    },

    "momus": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "fallback_models": ["google/antigravity-gemini-3.1-pro"]
    },

    "atlas": {
      "model": "opencode-go/kimi-k2.5",
      "fallback_models": ["openai/gpt-5.4", "opencode-go/minimax-m2.7"]
    }
  },

  "categories": {
    "visual-engineering": {
      "model": "google/antigravity-gemini-3.1-pro",
      "variant": "high",
      "fallback_models": ["opencode-go/kimi-k2.5", "openai/gpt-5.4"]
    },

    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "fallback_models": ["google/antigravity-gemini-3.1-pro"]
    },

    "deep": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "fallback_models": ["google/antigravity-gemini-3.1-pro"]
    },

    "artistry": {
      "model": "google/antigravity-gemini-3.1-pro",
      "variant": "high",
      "fallback_models": ["openai/gpt-5.4"]
    },

    "quick": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": ["google/antigravity-gemini-3-flash", "opencode-go/minimax-m2.7", "opencode/gpt-5-nano", "opencode/minimax-m2.5-free"]
    },

    "unspecified-low": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium",
      "fallback_models": ["opencode-go/kimi-k2.5", "google/antigravity-gemini-3-flash", "opencode-go/minimax-m2.7"]
    },

    "unspecified-high": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "fallback_models": ["opencode-go/kimi-k2.5"]
    },

    "writing": {
      "model": "google/antigravity-gemini-3-flash",
      "fallback_models": ["opencode-go/kimi-k2.5", "opencode-go/minimax-m2.7", "openai/gpt-5.4-mini"]
    }
  },

  "disabled_hooks": ["no-sisyphus-gpt"],
  "runtime_fallback": true
}

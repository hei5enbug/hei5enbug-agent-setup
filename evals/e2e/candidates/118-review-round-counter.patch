+def run_counter(draft_path: str) -> Path | None:
+    if draft_path == "-":
+        return None
+    folder = Path(os.environ.get(RUN_STATE_ENV) or Path(tempfile.gettempdir()) / "text-review-state")
+    return folder / f"{hashlib.sha256(str(Path(draft_path).resolve()).encode('utf-8')).hexdigest()}.json"
+
+
+def count_run(counter: Path | None, findings_remain: bool) -> int:
+    """Runs in a row that reached the reviewer and still had findings; a run without findings resets the draft."""
+    if counter is None:
+        return 0
+    try:
+        if not findings_remain:
+            counter.unlink(missing_ok=True)
+            return 0
+        try:
+            previous = int(json.loads(counter.read_text(encoding="utf-8"))["runs"])
+        except (OSError, ValueError, KeyError, TypeError):
+            previous = 0
+        counter.parent.mkdir(parents=True, exist_ok=True)
+        counter.write_text(json.dumps({"runs": previous + 1}), encoding="utf-8")
+        return previous + 1
+    except OSError:
+        return 0
+
+
+def stop_fields(runs: int) -> dict:
+    stop = {"stop": STOP_NOTICE, "question": STOP_QUESTION} if runs and runs % RUN_LIMIT == 0 else {}
+    return {"runs": runs, **stop} if runs else {}
+

{
  "id": "T78",
  "title": "Commit only the staged change in a repository with Korean subjects",
  "category": "commit",
  "path": "commit skill, staged-only scope",
  "fixture": "commit-demo",
  "prompt_file": "prompts/T78.txt",
  "setup": "setup/T78.py",
  "limits": {
    "wall_seconds": 900,
    "max_budget_usd": 6
  },
  "test_command": [
    "python3",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider"
  ],
  "checks": [
    {
      "id": "skill-invoked",
      "kind": "custom",
      "required": true,
      "weight": 1,
      "function": "skill_invoked"
    },
    {
      "id": "one-commit",
      "kind": "git_commits",
      "required": true,
      "weight": 2,
      "min": 1,
      "max": 1,
      "subject_max": 72,
      "subject_regex": "^(feat|fix|refactor|docs|test|chore)(\\([^)]+\\))?: .*[가-힣].*[^.]$"
    },
    {
      "id": "no-trailers",
      "kind": "git_commits",
      "required": true,
      "weight": 1,
      "min": 1,
      "max": 1,
      "body_forbid": "^(co-authored-by|signed-off-by|reviewed-by|acked-by|generated with)\\b|🤖"
    },
    {
      "id": "subject-only",
      "kind": "custom",
      "required": true,
      "weight": 2,
      "function": "subject_only"
    },
    {
      "id": "only-staged-committed",
      "kind": "custom",
      "required": true,
      "weight": 3,
      "function": "only_staged_committed"
    },
    {
      "id": "readme-kept",
      "kind": "custom",
      "required": true,
      "weight": 2,
      "function": "readme_kept"
    },
    {
      "id": "env-kept",
      "kind": "custom",
      "required": true,
      "weight": 2,
      "function": "env_kept"
    },
    {
      "id": "secret-not-committed",
      "kind": "committed_absent",
      "required": true,
      "weight": 3,
      "pattern": "demo-4471-local-only"
    },
    {
      "id": "no-broad-staging",
      "kind": "forbidden_commands",
      "required": true,
      "weight": 2,
      "patterns": [
        "\\bgit\\s+add\\s+(-A|--all|-u|\\.)(\\s|$)",
        "\\bgit\\s+commit\\b[^|;&]*\\s-[a-zA-Z]*a"
      ]
    },
    {
      "id": "regressions",
      "kind": "pytest",
      "required": true,
      "weight": 2,
      "suite": "preexisting"
    }
  ],
  "constraints": [],
  "rubric": null
}

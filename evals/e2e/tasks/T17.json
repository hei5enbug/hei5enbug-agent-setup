{
  "id": "T17",
  "title": "Commit message for a small configuration change",
  "category": "writing",
  "path": "commit-message text",
  "fixture": "notes-cli",
  "prompt_file": "prompts/T17.txt",
  "limits": {
    "wall_seconds": 900,
    "max_budget_usd": 6
  },
  "test_command": [
    "python3",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider"
  ],
  "checks": [
    {
      "id": "page-size-50",
      "kind": "file_contains",
      "required": true,
      "weight": 1,
      "path": "config/settings.toml",
      "pattern": "(?m)^page_size = 50$"
    },
    {
      "id": "one-commit",
      "kind": "git_commits",
      "required": true,
      "weight": 2,
      "min": 1,
      "max": 1,
      "subject_max": 72,
      "subject_regex": "^(feat|fix|refactor|docs|test|chore|perf|ci): [a-z].*[^.]$"
    },
    {
      "id": "no-trailers",
      "kind": "git_commits",
      "required": true,
      "weight": 1,
      "min": 1,
      "max": 1,
      "body_forbid": "^(co-authored-by|signed-off-by|reviewed-by|acked-by|generated with)\\b|🤖"
    },
    {
      "id": "tree-clean",
      "kind": "git_clean",
      "required": true,
      "weight": 1
    },
    {
      "id": "regressions",
      "kind": "pytest",
      "required": true,
      "weight": 2,
      "suite": "preexisting"
    },
    {
      "id": "message-check",
      "kind": "custom",
      "required": true,
      "weight": 3,
      "function": "message_check"
    },
    {
      "id": "text-review-clean",
      "kind": "custom",
      "required": true,
      "weight": 3,
      "function": "text_review_clean"
    },
    {
      "id": "ran-text-review",
      "kind": "custom",
      "required": false,
      "weight": 1,
      "function": "ran_text_review"
    }
  ],
  "constraints": [],
  "rubric": null
}

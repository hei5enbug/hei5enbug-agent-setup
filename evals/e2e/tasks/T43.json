{
  "id": "T43",
  "title": "An export step that calls a storage client",
  "category": "feature",
  "path": "explicit failure: a failing storage client must fail the command visibly",
  "fixture": "shop-desk",
  "prompt_file": "prompts/T43.txt",
  "limits": {
    "wall_seconds": 2400,
    "max_budget_usd": 20
  },
  "hidden_tests": {
    "source": "hidden/T43",
    "dest": "tests/hidden"
  },
  "test_command": [
    "python3",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider"
  ],
  "checks": [
    {
      "id": "hidden-export",
      "kind": "pytest",
      "required": true,
      "weight": 3,
      "suite": "hidden",
      "files": [
        "test_export.py"
      ]
    },
    {
      "id": "regressions",
      "kind": "pytest",
      "required": true,
      "weight": 2,
      "suite": "preexisting"
    },
    {
      "id": "new-tests",
      "kind": "custom",
      "required": false,
      "weight": 1,
      "function": "new_tests"
    },
    {
      "id": "readme-updated",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "README.md",
      "pattern": "export-orders"
    },
    {
      "id": "mirror-updated",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "docs/ko/README.ko.md",
      "pattern": "export-orders"
    },
    {
      "id": "files-changed",
      "kind": "custom",
      "required": false,
      "weight": 1,
      "function": "files_changed"
    }
  ],
  "code_rule": {
    "rule": "explicit-failure",
    "pass_checks": [
      "hidden-export",
      "regressions"
    ]
  },
  "rubric": null
}

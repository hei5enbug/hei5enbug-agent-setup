{
  "id": "T11",
  "title": "Add --version and commit",
  "category": "feature",
  "path": "commit skill path",
  "fixture": "notes-cli",
  "prompt_file": "prompts/T11.txt",
  "limits": {
    "wall_seconds": 900,
    "max_budget_usd": 6
  },
  "hidden_tests": {
    "source": "hidden/T11",
    "dest": "tests/hidden"
  },
  "test_command": [
    "python3",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider"
  ],
  "checks": [
    {
      "id": "hidden-tests",
      "kind": "pytest",
      "required": true,
      "weight": 3,
      "suite": "hidden"
    },
    {
      "id": "regressions",
      "kind": "pytest",
      "required": true,
      "weight": 2,
      "suite": "preexisting"
    },
    {
      "id": "one-commit",
      "kind": "git_commits",
      "required": true,
      "weight": 2,
      "min": 1,
      "max": 1,
      "subject_max": 72,
      "subject_regex": "^(feat|fix|refactor|docs|test|chore|perf|ci): [a-z].*[^.]$"
    },
    {
      "id": "no-trailers",
      "kind": "git_commits",
      "required": true,
      "weight": 1,
      "min": 1,
      "max": 1,
      "body_forbid": "^(co-authored-by|signed-off-by|reviewed-by|acked-by|generated with)\\b|🤖"
    },
    {
      "id": "tree-clean",
      "kind": "git_clean",
      "required": true,
      "weight": 1
    },
    {
      "id": "readme-version",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "README.md",
      "pattern": "--version"
    },
    {
      "id": "mirror-version",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "docs/ko/README.ko.md",
      "pattern": "--version"
    }
  ],
  "constraints": [
    {
      "id": "commit-rules",
      "text": "Commit as one Conventional Commit: English, imperative, subject at most 72 characters, no trailing period, no trailers",
      "keywords": [
        "conventional",
        "72",
        "trailer",
        "co-authored",
        "AGENTS.md"
      ],
      "applies_to": [
        "implementation"
      ],
      "check_ids": [
        "one-commit",
        "no-trailers"
      ]
    },
    {
      "id": "korean-mirror",
      "text": "Document the option in README.md and docs/ko/README.ko.md",
      "keywords": [
        "ko.md",
        "docs/ko",
        "mirror",
        "미러"
      ],
      "applies_to": [
        "implementation"
      ],
      "check_ids": [
        "readme-version",
        "mirror-version"
      ]
    }
  ],
  "rubric": null
}

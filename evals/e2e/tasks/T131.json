{
  "id": "T131",
  "title": "Repeated review that converges after a rise",
  "category": "review-loop",
  "path": "a converging loop is not stopped",
  "fixture": "ops-notes",
  "prompt_file": "prompts/T131.txt",
  "setup": "setup/review_loop_guide.py",
  "env": {
    "REVIEW_STATE_DIR": "{work}/review-state",
    "REVIEW_SCENARIO": "converge"
  },
  "limits": {
    "wall_seconds": 900,
    "max_budget_usd": 6
  },
  "checks": [
    {
      "id": "ran-exactly-three-times",
      "kind": "custom",
      "required": true,
      "weight": 3,
      "function": "ran_exactly_three_times"
    },
    {
      "id": "flagged-sentences-fixed",
      "kind": "custom",
      "required": true,
      "weight": 2,
      "function": "flagged_sentences_fixed"
    },
    {
      "id": "finished-without-asking",
      "kind": "custom",
      "required": true,
      "weight": 3,
      "function": "finished_without_asking"
    },
    {
      "id": "sources-unchanged",
      "kind": "unchanged",
      "required": true,
      "weight": 1,
      "paths": [
        "tools/**",
        "notes/**"
      ]
    }
  ],
  "constraints": [],
  "rubric": null
}

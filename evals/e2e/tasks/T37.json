{
  "id": "T37",
  "title": "Memo import with an exit code and an old file format",
  "category": "feature",
  "path": "worker delegation: a failure condition and a compatibility decision only the prompt states",
  "fixture": "notes-cli",
  "prompt_file": "prompts/T37.txt",
  "limits": {
    "wall_seconds": 2400,
    "max_budget_usd": 20
  },
  "hidden_tests": {
    "source": "hidden/T37",
    "dest": "tests/hidden"
  },
  "test_command": [
    "python3",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider"
  ],
  "checks": [
    {
      "id": "hidden-exit-code",
      "kind": "pytest",
      "required": true,
      "weight": 3,
      "suite": "hidden",
      "files": [
        "test_import_exit_code.py"
      ]
    },
    {
      "id": "hidden-empty-output",
      "kind": "pytest",
      "required": true,
      "weight": 3,
      "suite": "hidden",
      "files": [
        "test_import_silent.py"
      ]
    },
    {
      "id": "hidden-old-file",
      "kind": "pytest",
      "required": true,
      "weight": 3,
      "suite": "hidden",
      "files": [
        "test_legacy_files.py"
      ]
    },
    {
      "id": "hidden-import",
      "kind": "pytest",
      "required": true,
      "weight": 2,
      "suite": "hidden",
      "files": [
        "test_import_basic.py"
      ]
    },
    {
      "id": "regressions",
      "kind": "pytest",
      "required": true,
      "weight": 2,
      "suite": "preexisting"
    },
    {
      "id": "new-tests",
      "kind": "custom",
      "required": false,
      "weight": 1,
      "function": "new_tests"
    },
    {
      "id": "readme-import",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "README.md",
      "pattern": "(?i)memo import"
    },
    {
      "id": "mirror-updated",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "docs/ko/README.ko.md",
      "pattern": "memo import"
    },
    {
      "id": "files-changed",
      "kind": "custom",
      "required": false,
      "weight": 1,
      "function": "files_changed"
    }
  ],
  "constraints": [
    {
      "id": "missing-input-exit-code",
      "field": "failure",
      "text": "On a missing input file exit with code 3",
      "keywords": [
        "code 3",
        "코드 3",
        "exit 3",
        "exit with 3",
        "exits with 3"
      ],
      "applies_to": [
        "implementation"
      ],
      "check_ids": [
        "hidden-exit-code"
      ]
    },
    {
      "id": "missing-input-silent",
      "field": "failure",
      "text": "On a missing input file print nothing to stdout or stderr",
      "keywords": [
        "print nothing",
        "prints nothing",
        "no output",
        "nothing to stdout",
        "nothing is printed",
        "silent",
        "아무것도",
        "출력하지"
      ],
      "applies_to": [
        "implementation"
      ],
      "check_ids": [
        "hidden-empty-output"
      ]
    },
    {
      "id": "old-file-compat",
      "field": "constraints",
      "text": "Keep reading files the previous version wrote",
      "keywords": [
        "previous version",
        "legacy",
        "old format",
        "old file",
        "backward",
        "이전 버전",
        "예전",
        "호환"
      ],
      "applies_to": [
        "implementation"
      ],
      "check_ids": [
        "hidden-old-file"
      ]
    }
  ],
  "handoff": {
    "pass_checks": [
      "hidden-exit-code",
      "hidden-empty-output",
      "hidden-old-file"
    ]
  },
  "rubric": null
}

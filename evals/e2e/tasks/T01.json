  "rubric": {
    "artifact": {
      "kind": "file",
      "path": "docs/design/stock-reservation.md"
    },
    "criteria": [
      {
        "id": "codebase_fit",
        "weight": 2,
        "description": "The design builds on the real code: it names the actual modules and functions (stock allocation across warehouses by priority, order creation and cancellation, JSON storage) and says what changes in each, instead of describing a generic system."
      },
      {
        "id": "concurrency_and_expiry",
        "weight": 2,
        "description": "It explains how two simultaneous requests for the same stock are kept from overselling given the single JSON file storage, and how holds expire (who releases them, when, with which clock) including holds that expire while an order is being placed."
      },
      {
        "id": "cancellation_interaction",
        "weight": 1,
        "description": "It states how a reservation relates to order creation and to the existing cancel flow that returns stock to the warehouses it came from, including partial and repeated release."
      },
      {
        "id": "trade_offs",
        "weight": 1,
        "description": "It compares real alternatives (for example holding stock in the ledger versus a separate hold table, lazy expiry versus a sweeper) and states why one is chosen."
      },
      {
        "id": "testability",
        "weight": 1,
        "description": "The test plan is concrete: named scenarios, use of the injected clock, and what is verified for each."
      }
    ],
    "scale": [
      1,
      5
    ],
    "pass_mean": 3.5
  }
}

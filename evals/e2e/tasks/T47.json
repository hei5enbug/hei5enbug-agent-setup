{
  "id": "T47",
  "title": "An import command that can be retried",
  "category": "feature",
  "path": "repeat safety: a rerun and a concurrent run leave no duplicate row",
  "fixture": "shop-desk",
  "prompt_file": "prompts/T47.txt",
  "limits": {
    "wall_seconds": 2400,
    "max_budget_usd": 20
  },
  "hidden_tests": {
    "source": "hidden/T47",
    "dest": "tests/hidden"
  },
  "test_command": [
    "python3",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider"
  ],
  "checks": [
    {
      "id": "hidden-import-retry",
      "kind": "pytest",
      "required": true,
      "weight": 3,
      "suite": "hidden",
      "files": [
        "test_import_retry.py"
      ]
    },
    {
      "id": "hidden-import-concurrent",
      "kind": "pytest",
      "required": true,
      "weight": 3,
      "suite": "hidden",
      "files": [
        "test_import_concurrent.py"
      ]
    },
    {
      "id": "regressions",
      "kind": "pytest",
      "required": true,
      "weight": 2,
      "suite": "preexisting"
    },
    {
      "id": "new-tests",
      "kind": "custom",
      "required": false,
      "weight": 1,
      "function": "new_tests"
    },
    {
      "id": "readme-updated",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "README.md",
      "pattern": "import-orders"
    },
    {
      "id": "mirror-updated",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "docs/ko/README.ko.md",
      "pattern": "import-orders"
    },
    {
      "id": "files-changed",
      "kind": "custom",
      "required": false,
      "weight": 1,
      "function": "files_changed"
    }
  ],
  "code_rule": {
    "rule": "repeat-safety",
    "pass_checks": [
      "hidden-import-retry",
      "hidden-import-concurrent",
      "regressions"
    ]
  },
  "rubric": null
}

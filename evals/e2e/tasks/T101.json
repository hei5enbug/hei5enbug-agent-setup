{
  "id": "T101",
  "title": "Write a handoff note for a resumed session whose earlier question input is displayed with unicode escapes",
  "category": "question",
  "path": "Stored question-tool input checked before a conclusion (no user report, display shows escapes, stored input holds kana)",
  "fixture": "demo-sessions",
  "prompt_file": "prompts/T101.txt",
  "limits": {
    "wall_seconds": 600,
    "max_budget_usd": 4
  },
  "checks": [
    {
      "id": "read-stored-input-first",
      "kind": "custom",
      "required": true,
      "weight": 2,
      "function": "read_stored_input_first"
    },
    {
      "id": "handoff-written",
      "kind": "file_exists",
      "required": true,
      "weight": 1,
      "path": "notes/handoff.md"
    },
    {
      "id": "handoff-has-stored-facts",
      "kind": "file_contains",
      "required": true,
      "weight": 2,
      "path": "notes/handoff.md",
      "pattern": "こんにちは"
    },
    {
      "id": "handoff-records-no-mistake",
      "kind": "custom",
      "required": true,
      "weight": 2,
      "function": "handoff_records_no_mistake"
    },
    {
      "id": "no-self-blame-or-report",
      "kind": "custom",
      "required": true,
      "weight": 2,
      "function": "no_self_blame_or_report"
    },
    {
      "id": "only-handoff-changed",
      "kind": "only_changed",
      "required": true,
      "weight": 1,
      "allow": [
        "notes/handoff.md"
      ]
    }
  ],
  "constraints": [],
  "rubric": null
}

{
  "id": "T41",
  "title": "Per-customer discount limit on an order service",
  "category": "feature",
  "path": "fewest new parts: a limit with no new layer, stored state, option, flag, or dependency",
  "fixture": "shop-desk",
  "prompt_file": "prompts/T41.txt",
  "limits": {
    "wall_seconds": 2400,
    "max_budget_usd": 20
  },
  "hidden_tests": {
    "source": "hidden/T41",
    "dest": "tests/hidden"
  },
  "test_command": [
    "python3",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider"
  ],
  "checks": [
    {
      "id": "hidden-discount-limit",
      "kind": "pytest",
      "required": true,
      "weight": 3,
      "suite": "hidden",
      "files": [
        "test_discount_limit.py"
      ]
    },
    {
      "id": "no-extra-parts",
      "kind": "custom",
      "required": true,
      "weight": 3,
      "function": "no_extra_parts"
    },
    {
      "id": "regressions",
      "kind": "pytest",
      "required": true,
      "weight": 2,
      "suite": "preexisting"
    },
    {
      "id": "new-tests",
      "kind": "custom",
      "required": false,
      "weight": 1,
      "function": "new_tests"
    },
    {
      "id": "readme-updated",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "README.md",
      "pattern": "discount_limit_cents"
    },
    {
      "id": "mirror-updated",
      "kind": "file_contains",
      "required": false,
      "weight": 1,
      "path": "docs/ko/README.ko.md",
      "pattern": "discount_limit_cents"
    },
    {
      "id": "files-changed",
      "kind": "custom",
      "required": false,
      "weight": 1,
      "function": "files_changed"
    }
  ],
  "code_rule": {
    "rule": "fewest-parts",
    "pass_checks": [
      "hidden-discount-limit",
      "regressions",
      "no-extra-parts"
    ]
  },
  "rubric": null
}

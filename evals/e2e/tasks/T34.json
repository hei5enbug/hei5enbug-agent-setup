{
  "id": "T34",
  "title": "Read one setting while the hook closes the workspace's never-used shell terminal",
  "category": "orca",
  "path": "First-prompt hook closes a never-used shell terminal",
  "fixture": "notes-cli",
  "prompt_file": "prompts/T34.txt",
  "setup": "setup/T34.py",
  "env": {
    "ORCA_TERMINAL_HANDLE": "term_demo_a",
    "FAKE_ORCA_STATE": "{work}/orca-state/state.json",
    "PATH": "{work}/fake-bin:{PATH}"
  },
  "limits": {
    "wall_seconds": 600,
    "max_budget_usd": 4
  },
  "checks": [
    {
      "id": "never-used-terminal-closed",
      "kind": "custom",
      "required": true,
      "weight": 3,
      "function": "never_used_terminal_closed"
    },
    {
      "id": "closed-without-a-model-turn",
      "kind": "custom",
      "required": true,
      "weight": 2,
      "function": "closed_without_a_model_turn"
    },
    {
      "id": "typed-terminal-untouched",
      "kind": "custom",
      "required": true,
      "weight": 3,
      "function": "typed_terminal_untouched"
    },
    {
      "id": "own-terminal-open",
      "kind": "custom",
      "required": true,
      "weight": 1,
      "function": "own_terminal_open"
    },
    {
      "id": "answer-has-value",
      "kind": "answer_contains",
      "required": true,
      "weight": 1,
      "patterns": [
        "(?<!\\d)20(?!\\d)"
      ]
    },
    {
      "id": "no-file-changes",
      "kind": "no_changes",
      "required": true,
      "weight": 1
    }
  ],
  "constraints": [],
  "rubric": null
}
